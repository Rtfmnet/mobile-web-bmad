rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/notes/{noteId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validNote() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'body', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['title', 'body', 'createdAt', 'updatedAt'])
          && data.title is string
          && data.title.size() <= 120
          && data.body is string
          && data.body.size() <= 10000
          && data.createdAt is int
          && data.updatedAt is int;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && validNote()
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if isOwner()
        && validNote()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}